[Unit]
Description=TStock FastAPI data service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/tstock/backend
EnvironmentFile=-/opt/tstock/backend/.env
ExecStart=/opt/tstock/backend/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
